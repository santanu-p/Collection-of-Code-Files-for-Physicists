Cell["\<\
Here is the definition of the coordinate system, and the metric:
Simply define the list coords = {....} and the matrix gmatrix\
\>", "Text",
 CellChangeTimes->{{3.888727629358975*^9, 3.888727638267356*^9}, {
  3.88872784886689*^9, 3.8887278531071978`*^9}, {3.888728536899967*^9, 
  3.888728561316792*^9}},ExpressionUUID->"76af4325-c92f-4d68-9f5d-\
696198fb95e3"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"coords", " ", "=", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"t", "[", "]"}], ",", 
      RowBox[{"x", "[", "]"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"DefConstantSymbol", "[", 
     RowBox[{"mass", ",", 
      RowBox[{"PrintAs", "\[Rule]", "\"\<M\>\""}]}], "]"}], ";"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"DefScalarFunction", "[", 
    RowBox[{"ascale", ",", 
     RowBox[{"PrintAs", "->", "\"\<a\>\""}]}], "]"}], ";"}], " ", 
  RowBox[{"(*", 
   RowBox[{"Use", " ", "as", " ", 
    RowBox[{"e", ".", "g", ".", " ", 
     RowBox[{"ascale", "[", 
      RowBox[{
       RowBox[{"t", "[", "]"}], ",", 
       RowBox[{"r", "[", "]"}]}], "]"}]}], " ", "for", " ", "a", " ", 
    "function", " ", "of", " ", 
    RowBox[{"(", 
     RowBox[{"t", ",", "r"}], ")"}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"gmatrix", " ", "=", " ", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       FractionBox[
        RowBox[{"t", "[", "]"}], 
        SqrtBox[
         RowBox[{"1", "+", 
          SuperscriptBox[
           RowBox[{"t", "[", "]"}], "2"]}]]], ",", "   ", 
       FractionBox[
        RowBox[{"-", "1"}], 
        SqrtBox[
         RowBox[{"1", "+", 
          SuperscriptBox[
           RowBox[{"t", "[", "]"}], "2"]}]]]}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"{", "  ", 
      RowBox[{
       FractionBox[
        RowBox[{"-", "1"}], 
        SqrtBox[
         RowBox[{"1", "+", 
          SuperscriptBox[
           RowBox[{"t", "[", "]"}], "2"]}]]], ",", "  ", 
       FractionBox[
        RowBox[{"-", 
         RowBox[{"t", "[", "]"}]}], 
        SqrtBox[
         RowBox[{"1", "+", 
          SuperscriptBox[
           RowBox[{"t", "[", "]"}], "2"]}]]]}], "}"}]}], 
    "\[IndentingNewLine]", "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"DefChart", "[", 
   RowBox[{"ch", ",", "M", ",", 
    RowBox[{"{", 
     RowBox[{"0", ",", "1"}], "}"}], ",", "coords", ",", 
    RowBox[{"ChartColor", "\[Rule]", "Blue"}]}], "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"g", "=", 
   RowBox[{"CTensor", "[", 
    RowBox[{"gmatrix", ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "ch"}], ",", 
       RowBox[{"-", "ch"}]}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"SetCMetric", "[", 
   RowBox[{"g", ",", "ch", ",", 
    RowBox[{"SignatureOfMetric", "->", " ", 
     RowBox[{"{", 
      RowBox[{"1", ",", "1", ",", "0"}], "}"}]}]}], "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"CD", " ", "=", " ", 
   RowBox[{"CovDOfMetric", "[", "g", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"$Assumptions", " ", "=", " ", 
   RowBox[{
    RowBox[{"0", "<", 
     RowBox[{"x", "[", "]"}], "<", "1"}], " ", "&&", " ", 
    RowBox[{"t", "\[Element]", "Reals"}]}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.88872764099708*^9, 3.888727843739778*^9}, {
   3.888728385012411*^9, 3.888728394248955*^9}, 3.88872846817772*^9, 
