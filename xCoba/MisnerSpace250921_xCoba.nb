Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{"tcp0", ",", "xcp0", ",", "xc0", ",", "tc0"}], "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"xcp0", " ", "=", " ", "0.9"}], ";", " ", 
  RowBox[{"\[Tau]max", "=", " ", "2.7"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"xc0", "   ", "=", " ", "0.5"}], ";", 
  RowBox[{"tc0", " ", "=", " ", 
   RowBox[{"-", "1.0"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"direction", " ", "=", " ", "1"}], ";"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"1", " ", "or", " ", "2"}], ",", " ", 
    RowBox[{"the", " ", "two", " ", "roots", " ", "in", " ", 
     RowBox[{"nullcon", ".", " ", "The"}], " ", "negative", " ", "sign", " ", 
     "is", " ", "backwards", " ", "in", " ", "time", " ", "t"}]}], " ", 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"tcp0", "=", " ", 
   RowBox[{"tcp0", " ", "/.", 
    RowBox[{"nullcon", "[", 
     RowBox[{"[", 
      RowBox[{"direction", ",", "1"}], "]"}], "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{
   "\"\<\!\(\*SubscriptBox[\(x\), \(0\)]\)= \>\"", ",", "xc0", ",", 
    "\"\<  \!\(\*SubscriptBox[\(t\), \(0\)]\)= \>\"", ",", "tc0", ",", 
    "\"\<  \!\(\*SubscriptBox[OverscriptBox[\(x\), \(.\)], \(0\)]\)= \>\"", 
    ",", " ", "xcp0", ",", 
    "\"\<  \!\(\*SubscriptBox[OverscriptBox[\(t\), \(.\)], \(0\)]\)= \>\"", 
    ",", "tcp0"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"dsol", " ", "=", " ", 
   RowBox[{"NDSolve", "[", 
    RowBox[{
     RowBox[{"{", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"tc", "''"}], "[", "\[Tau]", "]"}], " ", "==", " ", 
        RowBox[{"rhs", "[", 
         RowBox[{"[", "1", "]"}], "]"}]}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"xc", "''"}], "[", "\[Tau]", "]"}], " ", "==", " ", 
        RowBox[{"rhs", "[", 
         RowBox[{"[", "2", "]"}], "]"}]}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"tc", "'"}], "  ", "[", "0", "]"}], " ", "==", " ", "tcp0"}],
        ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"xc", "'"}], "  ", "[", "0", "]"}], " ", "==", " ", "xcp0"}],
        ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"tc", "     ", "[", "0", "]"}], " ", "==", " ", "tc0"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"xc", "     ", "[", "0", "]"}], " ", "==", " ", "xc0"}]}], 
      "\[IndentingNewLine]", "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"tc", ",", "xc"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"\[Tau]", ",", "0", ",", "\[Tau]max"}], "}"}]}], 
    "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"{", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"ParametricPlot", "[", 
    RowBox[{
     RowBox[{"Evaluate", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Mod", "[", 
          RowBox[{
           RowBox[{"xc", "[", "\[Tau]", "]"}], ",", "1.0"}], "]"}], ",", 
         RowBox[{"tc", "[", "\[Tau]", "]"}]}], "}"}], "/.", "dsol"}], "]"}], 
     ",", 
     RowBox[{"{", 
      RowBox[{"\[Tau]", ",", "0", ",", "\[Tau]max"}], "}"}], ",", 
     RowBox[{"Exclusions", "\[Rule]", "\"\<Discontinuities\>\""}]}], "]"}], 
   ",", "\[IndentingNewLine]", 
   RowBox[{"ParametricPlot3D", "[", 
    RowBox[{
     RowBox[{"Evaluate", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Cos", "[", 
          RowBox[{"2", " ", "\[Pi]", " ", 
