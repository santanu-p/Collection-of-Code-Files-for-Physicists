  3.888728245264237*^9}},ExpressionUUID->"f5f15740-e075-460d-bdc9-\
dabca26af5cf"],

Cell[TextData[{
 "Print nonzero components:\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     SuperscriptBox["\[CapitalGamma]", "\[Lambda]"], "\[Mu]\[Nu]"], "=", 
    RowBox[{
     FractionBox["1", "2"], 
     RowBox[{
      SuperscriptBox["g", "\[Lambda]\[Sigma]"], "(", 
      RowBox[{
       RowBox[{
        SubscriptBox["\[PartialD]", "\[Mu]"], " ", 
        SubscriptBox["g", "\[Sigma]\[Nu]"]}], "+", 
       RowBox[{
        SubscriptBox["\[PartialD]", "\[Nu]"], " ", 
        SubscriptBox["g", "\[Sigma]\[Mu]"]}], "-", 
       RowBox[{
        SubscriptBox["\[PartialD]", "\[Sigma]"], " ", 
        SubscriptBox["g", "\[Mu]\[Nu]"]}]}], ")"}]}]}], TraditionalForm]],
  ExpressionUUID->"26653ec1-e65d-4650-9f56-3d5b6383add9"],
 "\nThe components of the Christoffel symbols are collected  by the \
ComponentArray[expr] function."
}], "Text",
 CellChangeTimes->{{3.888674583382744*^9, 3.888674588919388*^9}, {
  3.888729739373269*^9, 
  3.888729776479343*^9}},ExpressionUUID->"26d7a51e-c862-4926-99c0-\
e4ff1eaf1dd3"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"list", " ", "=", 
   RowBox[{"ComponentArray", "[", 
    RowBox[{
     RowBox[{"Christoffel", "[", 
      RowBox[{"CD", ",", "PDch"}], "]"}], "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\[Alpha]", ",", "ch"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "\[Beta]"}], ",", 
        RowBox[{"-", "ch"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "\[Gamma]"}], ",", 
        RowBox[{"-", "ch"}]}], "}"}]}], "]"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"list", " ", "=", " ", 
   RowBox[{"Table", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"If", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"UnsameQ", "[", 
        RowBox[{
         RowBox[{"list", "[", 
          RowBox[{"[", 
           RowBox[{"i", ",", "j", ",", "k"}], "]"}], "]"}], ",", "0"}], "]"}],
        ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Subscript", "[", 
          RowBox[{
           RowBox[{"Superscript", "[", 
            RowBox[{"\"\<\[CapitalGamma]\>\"", ",", 
             RowBox[{"i", "-", "1"}]}], "]"}], ",", 
           RowBox[{"j", "-", "1"}], ",", 
           RowBox[{"k", "-", "1"}]}], "]"}], ",", 
         RowBox[{"list", "[", 
          RowBox[{"[", 
           RowBox[{"i", ",", "j", ",", "k"}], "]"}], "]"}]}], "}"}]}], 
      "\[IndentingNewLine]", "]"}], ",", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"i", ",", "1", ",", 
       RowBox[{"Length", "[", "list", "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"j", ",", "1", ",", 
