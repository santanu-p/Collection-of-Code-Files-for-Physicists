Cell[TextData[{
 "This notebook has been programmed by ",
 ButtonBox["Konstantinos Anagnostopoulos",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["http://physics.ntua.gr/konstant"], None},
  ButtonNote->"http://physics.ntua.gr/konstant"],
 ", ",
 ButtonBox["Physics Department, National Technical University of Athens",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["http://het.physics.ntua.gr"], None},
  ButtonNote->"http://het.physics.ntua.gr"],
 ", Greece, while he was an instructor of the 4th year ",
 ButtonBox["undergraduate course \"General Relativity and Cosmology\"",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["http://physics.ntua.gr/konstant/GR/"], None},
  ButtonNote->"http://physics.ntua.gr/konstant/GR/"],
 ". It was created for fun, but it may turn out to be useful to everyone \
studying the General Theory of Relativity for the first time.\n",
 StyleBox["Email",
  FontWeight->"Bold"],
 ": konstant@mail.ntua.gr\n",
 StyleBox["Web",
  FontWeight->"Bold"],
 ":    http://physics.ntua.gr/konstant \nIt is offered under a ",
