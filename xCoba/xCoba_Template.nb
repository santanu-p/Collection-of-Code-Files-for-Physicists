      RowBox[{"j", ",", "1", ",", 
       RowBox[{"Length", "[", "list", "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"k", ",", "1", ",", "j"}], "}"}]}], "\[IndentingNewLine]", 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Partition", "[", 
   RowBox[{
    RowBox[{"DeleteCases", "[", 
     RowBox[{
      RowBox[{"Flatten", "[", "list", "]"}], ",", "Null"}], "]"}], ",", "2"}],
    "]"}], "//", "TableForm"}]}], "Input",
