         $CellContext`\[Theta][]]^2 Csc[
         $CellContext`\[Chi][]]^2}}], "\n", "g  =", 
   xAct`xCoba`CTensor[-$CellContext`ascale[
       $CellContext`t[]]^6 Sin[
       $CellContext`\[Theta][]]^2 Sin[
       $CellContext`\[Chi][]]^4, {}, 2 $CellContext`ch][], 
   " = ", -$CellContext`ascale[
      $CellContext`t[]]^6 Sin[
      $CellContext`\[Theta][]]^2 Sin[
      $CellContext`\[Chi][]]^4],
  Editable->False]], "Print",
