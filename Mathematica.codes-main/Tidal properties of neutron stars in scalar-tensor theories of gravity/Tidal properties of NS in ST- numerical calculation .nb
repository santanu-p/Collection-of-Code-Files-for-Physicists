        RowBox[{
         RowBox[{"A", "[", 
          RowBox[{"\[CurlyPhi]0", "[", "r_", "]"}], "]"}], "->", 
         SuperscriptBox["\[ExponentialE]", 
          RowBox[{
           FractionBox["1", "2"], "\[Beta]", " ", 
           SuperscriptBox[
            RowBox[{"\[CurlyPhi]0", "[", "r", "]"}], "2"]}]]}]}], "/.", 
       RowBox[{
        RowBox[{
         RowBox[{"A", "'"}], "[", 
