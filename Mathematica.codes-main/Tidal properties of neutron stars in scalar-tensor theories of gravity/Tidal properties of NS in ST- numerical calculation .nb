Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"This", " ", "takes", " ", "the", " ", "K", " ", "values", " ", 
     RowBox[{"from", " ", "[", "2", "]"}]}], ",", " ", 
    RowBox[{"multiplied", " ", "with", " ", 
     SuperscriptBox["c", "2"], " ", "to", " ", "get", " ", "the", " ", 
     "right", " ", "units"}], ",", " ", 
    RowBox[{
     RowBox[{
     "and", " ", "converts", "\[IndentingNewLine]", "them", " ", "into", " ", 
      "units", " ", "where", " ", "c"}], "=", 
     RowBox[{"G", "=", 
      RowBox[{"msun", "=", "1"}]}]}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"Cconst", "=", 
     RowBox[{"Rationalize", "[", 
      RowBox[{
       RowBox[{"2.99792458", "*", 
        RowBox[{"10", "^", 
         RowBox[{"(", "10", ")"}]}]}], ",", "0"}], "]"}]}], ";"}], 
   RowBox[{"(*", 
    RowBox[{"speed", " ", "of", " ", "light", " ", "in", " ", 
     RowBox[{"cm", "/", "s"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Gconst", "=", 
     RowBox[{"Rationalize", "[", 
      RowBox[{
       RowBox[{"6.67408", "*", 
        RowBox[{"10", "^", 
         RowBox[{"(", 
          RowBox[{"-", "8"}], ")"}]}]}], ",", "0"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"msun", "=", 
     RowBox[{"Rationalize", "[", 
      RowBox[{
       RowBox[{"1988500", "*", 
        RowBox[{"10", "^", 
         RowBox[{"(", "24", ")"}]}], "*", 
        RowBox[{"10", "^", "3"}]}], ",", "0"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"msunincm", "=", 
     RowBox[{"Rationalize", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Gconst", "/", 
         RowBox[{"Cconst", "^", "2"}]}], "*", "msun"}], ",", "0"}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"densitypercm2", "=", 
     RowBox[{"Rationalize", "[", 
      RowBox[{
       RowBox[{"Gconst", "/", 
        RowBox[{"Cconst", "^", "2"}]}], ",", "0"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Centi", "=", 
     RowBox[{"Rationalize", "[", 
      RowBox[{
       RowBox[{"1", "/", "msunincm"}], ",", "0"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"second", "=", 
     RowBox[{"Rationalize", "[", 
      RowBox[{
       RowBox[{"Cconst", "/", "msunincm"}], " ", ",", "0"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"gram", "=", 
     RowBox[{"Rationalize", "[", 
      RowBox[{
       RowBox[{"1", "/", "msun"}], ",", "0"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"gcm3", "=", 
     RowBox[{"Rationalize", "[", 
      RowBox[{
       RowBox[{"gram", "/", 
        RowBox[{"Centi", "^", "3"}]}], ",", "0"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"km", "=", 
     RowBox[{"Rationalize", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"10", "^", "5"}], "*", "Centi"}], ",", "0"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"press", "=", 
     RowBox[{"Rationalize", "[", 
      RowBox[{
       RowBox[{"gcm3", "/", 
        RowBox[{"Cconst", "^", "2"}]}], ",", "0"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"dynecm2", " ", "=", " ", 
     RowBox[{"Rationalize", "[", 
      RowBox[{
       RowBox[{"gcm3", "/", 
        RowBox[{"Cconst", "^", "2"}]}], ",", "0"}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", "RESOLUTION", " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Rho]vals", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"10", "^", "k"}], " ", "gcm3"}], ",", 
       RowBox[{"{", 
        RowBox[{"k", ",", "14.299", ",", "15.509", ",", "0.05"}], 
        RowBox[{"(*", " ", 
         RowBox[{"the", " ", "paper", " ", "used", " ", "0.01", " ", "here"}],
          " ", "*)"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"Kgeom", "[", 
      RowBox[{"Kcgs_", ",", " ", "gamma_"}], "]"}], " ", ":=", 
     RowBox[{"Kcgs", " ", "*", 
      RowBox[{"dynecm2", "/", 
       RowBox[{"(", 
        RowBox[{"gcm3", "^", "gamma"}], ")"}]}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"pressure", "[", 
      RowBox[{"\[Rho]_", ",", " ", "K_", ",", "\[CapitalGamma]_"}], "]"}], 
     " ", ":=", "  ", 
     RowBox[{"K", "*", 
      RowBox[{"\[Rho]", "^", "\[CapitalGamma]"}]}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"density", "[", 
      RowBox[{"p_", ",", " ", "K_", ",", "\[CapitalGamma]_"}], "]"}], " ", ":=",
      " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"p", "/", "K"}], ")"}], "^", 
      RowBox[{"(", 
       RowBox[{"1", "/", "\[CapitalGamma]"}], ")"}]}]}], " ", ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"epsiloneom", "[", 
      RowBox[{
      "p_", ",", " ", "K_", ",", " ", "\[CapitalGamma]_", ",", " ", "a_"}], 
      "]"}], " ", ":=", "  ", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"K", "/", 
         RowBox[{"(", 
          RowBox[{"\[CapitalGamma]", "-", "1"}], ")"}]}], ")"}], " ", "*", 
       " ", 
       RowBox[{
        RowBox[{"density", "[", 
         RowBox[{"p", ",", " ", "K", ",", " ", "\[CapitalGamma]"}], "]"}], 
        "^", "\[CapitalGamma]"}]}], " ", "+", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "+", "a"}], " ", ")"}], "*", 
       RowBox[{"density", "[", 
        RowBox[{"p", ",", " ", "K", ",", " ", "\[CapitalGamma]"}], 
        "]"}]}]}]}], " ", ";"}], "\n", 
   RowBox[{
    RowBox[{"rmin", "=", 
     SuperscriptBox["10", 
      RowBox[{"-", "10"}]]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"Background", " ", "precision"}], " ", "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
     "The", " ", "defaul", " ", "Working", " ", "precision", " ", "is", " ", 
      "15.95"}], ",", " ", 
     RowBox[{
     "and", " ", "the", " ", "Precision", " ", "and", " ", "Accurary", " ", 
      "are", " ", "both", " ", "set", " ", "to", " ", 
      RowBox[{"WorkingPrecision", "/", "2"}]}]}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"PrecisionRuleBack", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"PrecisionGoal", "\[Rule]", "10"}], ",", 
       RowBox[{"AccuracyGoal", "\[Rule]", "10"}], ",", 
       RowBox[{"WorkingPrecision", "\[Rule]", "20"}]}], "}"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"Polytrope", " ", "crust", " ", "definition"}], ",", " ", 
     RowBox[{
      RowBox[{"first", " ", "is", " ", "the", " ", "K"}], "-", "value"}], ",",
      " ", 
     RowBox[{"second", " ", "is", " ", "gamma"}], ",", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"third", " ", "is", " ", "border"}], "-", "value"}], ";", 
      RowBox[{"in", " ", "geometric", " ", "units"}]}]}], " ", "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"aFun", "[", 
      RowBox[{
      "a_", ",", " ", "g1_", ",", " ", "g2_", ",", " ", "Kval1_", ",", " ", 
       "Kval2_", ",", " ", "rhoVal_"}], "]"}], " ", ":=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"epsiloneom", "[", 
