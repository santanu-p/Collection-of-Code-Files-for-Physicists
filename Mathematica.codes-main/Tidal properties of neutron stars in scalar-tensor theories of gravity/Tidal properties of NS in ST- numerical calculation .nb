           FractionBox[
            RowBox[{"-", "1"}], 
            RowBox[{"A", "[", 
             RowBox[{"\[CurlyPhi]0", "[", "r", "]"}], "]"}]], 
           RowBox[{
            RowBox[{"A", "'"}], "[", 
