           RowBox[{"GN", "\[Rule]", "1"}]}], "/.", 
          RowBox[{
           RowBox[{"r", "[", "]"}], "\[Rule]", "r"}]}], "/.", 
         RowBox[{
          RowBox[{"\[Alpha]", "[", 
           RowBox[{"\[CurlyPhi]0", "[", "r_", "]"}], "]"}], "->", 
