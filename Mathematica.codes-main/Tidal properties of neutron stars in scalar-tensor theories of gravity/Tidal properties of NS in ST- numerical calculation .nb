Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"H0\[CurlyPhi]psolOrigintoSurfaceNoScalarGRWr", "[", 
    RowBox[{"p_", ",", "\[Beta]_", ",", "h_", ",", "ll_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"NDSolve", "[", 
     RowBox[{
      RowBox[{"SetPrecision", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"{", 
                RowBox[{
                 RowBox[{
                  RowBox[{"mastereqwithbackINN", "[", 
                   RowBox[{"[", "p", "]"}], "]"}], "\[Equal]", "0"}], ",", 
                 RowBox[{
                  RowBox[{"EoMscalarpertINN", "[", 
                   RowBox[{"[", "p", "]"}], "]"}], "\[Equal]", "0"}], ",", 
                 RowBox[{
                  RowBox[{"\[CurlyPhi]p", "[", "rmin", "]"}], "\[Equal]", 
                  "0"}], ",", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"\[CurlyPhi]p", "'"}], "[", "rmin", "]"}], 
                  "\[Equal]", " ", "0"}], ",", 
                 RowBox[{
                  RowBox[{"H0", "[", "rmin", "]"}], "\[Equal]", 
                  SuperscriptBox["rmin", "ll"]}], ",", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"H0", "'"}], "[", "rmin", "]"}], "\[Equal]", " ", 
                  RowBox[{"ll", " ", 
                   SuperscriptBox["rmin", 
                    RowBox[{"ll", "-", "1"}]]}]}]}], "}"}], "/.", 
               RowBox[{
                RowBox[{"A", "[", 
                 RowBox[{"\[CurlyPhi]0", "[", "r", "]"}], "]"}], "->", 
                SuperscriptBox["\[ExponentialE]", 
                 RowBox[{
                  FractionBox["1", "2"], 
                  RowBox[{"\[Beta]vals", "[", 
                   RowBox[{"[", "\[Beta]", "]"}], "]"}], 
                  SuperscriptBox[
                   RowBox[{"\[CurlyPhi]0", "[", "r", "]"}], "2"]}]]}]}], "/.", 
              RowBox[{
               RowBox[{
                RowBox[{"A", "'"}], "[", 
                RowBox[{"\[CurlyPhi]0", "[", "r", "]"}], "]"}], "->", 
               RowBox[{"D", "[", 
                RowBox[{
                 SuperscriptBox["\[ExponentialE]", 
                  RowBox[{
                   FractionBox["1", "2"], 
                   RowBox[{"\[Beta]vals", "[", 
                    RowBox[{"[", "\[Beta]", "]"}], "]"}], 
                   SuperscriptBox[
                    RowBox[{"\[CurlyPhi]0", "[", "r", "]"}], "2"]}]], ",", 
                 RowBox[{"\[CurlyPhi]0", "[", "r", "]"}]}], "]"}]}]}], "/.", 
             RowBox[{
              RowBox[{"\[Alpha]", "[", 
               RowBox[{"\[CurlyPhi]0", "[", "r", "]"}], "]"}], "->", 
              RowBox[{
               RowBox[{"-", 
                RowBox[{"\[Beta]vals", "[", 
                 RowBox[{"[", "\[Beta]", "]"}], "]"}]}], 
               RowBox[{"\[CurlyPhi]0", "[", "r", "]"}]}]}]}], "/.", 
            RowBox[{
             RowBox[{
              RowBox[{"\[Alpha]", "'"}], "[", 
              RowBox[{"\[CurlyPhi]0", "[", "r", "]"}], "]"}], "->", 
             RowBox[{"-", 
              RowBox[{"\[Beta]vals", "[", 
               RowBox[{"[", "\[Beta]", "]"}], "]"}]}]}]}], "/.", "scalarGR"}],
           "/.", 
          RowBox[{"l", "\[Rule]", "ll"}]}], "/.", 
         RowBox[{
