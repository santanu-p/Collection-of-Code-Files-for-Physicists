Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"EqHCol", "=", 
  RowBox[{"Collect", "[", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"mastereqwithbackOUT", "/.", 
       RowBox[{
        RowBox[{
         SuperscriptBox["mm", "\[Prime]",
          MultilineFunction->None], "[", "r", "]"}], "->", 
        RowBox[{
         FractionBox["1", "2"], " ", "r", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"r", " ", 
            SuperscriptBox[
             RowBox[{
              SuperscriptBox["\[CurlyPhi]0", "\[Prime]",
               MultilineFunction->None], "[", "r", "]"}], "2"]}], "-", 
           RowBox[{"2", " ", 
            RowBox[{"mm", "[", "r", "]"}], " ", 
            SuperscriptBox[
             RowBox[{
              SuperscriptBox["\[CurlyPhi]0", "\[Prime]",
